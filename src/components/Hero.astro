---
---

<section id="top" class="relative flex flex-1 items-center overflow-hidden">
  <div class="bb-dots" aria-hidden="true"></div>

  <div
    class="max-w-shell gap-hero-gap px-gutter pt-hero-top pb-hero-bottom relative mx-auto grid w-full grid-cols-1 items-center md:grid-cols-[1.1fr_0.9fr]"
  >
    <div>
      <h1 class="text-display text-pretty">Security and load audits.</h1>
      <p class="text-lead text-muted max-w-lead mt-7 text-pretty">
        We find the vulnerabilities and the breaking points before production does.
      </p>
    </div>

    <div class="max-w-orb bg-surface shadow-orb relative mx-auto aspect-square w-full overflow-hidden rounded-full md:max-w-none">
      <video
        class="bb-orb-video absolute inset-0 h-full w-full object-cover opacity-90 mix-blend-screen"
        poster="/orb-poster.jpg"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
      >
        <source src="/dots.mp4" type="video/mp4" media="(prefers-reduced-motion: no-preference)" />
      </video>
    </div>

    <p class="text-services text-dim col-span-full mt-4 font-mono">
      Application security · Smart contracts · Load testing · Cloud infrastructure · Code review
    </p>
  </div>
</section>
